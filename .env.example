# Copy this file to `.env.local` and fill in the values.

# --- Database (Neon Postgres) ---
# Neon dashboard -> Project -> Connection Details. Use the pooled connection string.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"

# --- Better Auth ---
# Generate with: npx auth@latest secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-random-32-char-secret"
# Base URL of the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# --- Public ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
